#!/bin/sh
set -e

echo "==> Checking Go file formatting..."
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "Error: The following Go files are not formatted correctly:"
	echo "$unformatted"
	echo ""
	echo "Auto-formatting files..."
	# Format the files on disk
	gofmt -w $unformatted
	echo "Files formatted. Please stage the changes (git add) and try committing again."
	exit 1
fi

echo "==> Running go vet..."
go vet ./...
