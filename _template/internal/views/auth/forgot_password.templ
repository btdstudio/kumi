package auth

templ ForgotPasswordPage(csrfToken string) {
	@Layout("Reset Password — goph", "We'll send you a reset link") {
		<form
			hx-post="/auth/forgot-password"
			hx-target="#auth-error"
			hx-swap="innerHTML"
			hx-indicator="#forgot-spinner"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div class="mb-4">
				<label for="email" class="form-label small text-muted">Email</label>
				<input
					type="email"
					class="form-control"
					id="email"
					name="email"
					placeholder="you@example.com"
					required
					autofocus
				/>
			</div>
			<div id="auth-error" class="mb-3"></div>
			<button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 position-relative">
				<span id="forgot-spinner" class="htmx-indicator spinner-border spinner-border-sm position-absolute top-50 start-50 translate-middle" role="status"></span>
				Send Reset Link
			</button>
		</form>
		<hr class="my-4"/>
		<p class="text-center text-muted small mb-0">
			<a href="/auth/login" style="color:var(--ctp-lavender);">Back to sign in</a>
		</p>
	}
}
