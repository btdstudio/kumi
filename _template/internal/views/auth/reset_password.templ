package auth

templ ResetPasswordPage(valid bool, token, errorMsg, csrfToken string) {
	@Layout("Set New Password — goph", "Choose a new password") {
		if !valid {
			<div class="alert alert-danger py-2 small mb-3" role="alert">
				{ errorMsg }
			</div>
			<a href="/auth/forgot-password" class="btn btn-primary w-100">
				Request a new link
			</a>
		} else {
			<form
				hx-post="/auth/reset-password"
				hx-target="#auth-error"
				hx-swap="innerHTML"
				hx-indicator="#reset-spinner"
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="hidden" name="token" value={ token }/>
				<div class="mb-3">
					<label for="password" class="form-label small text-muted">New password</label>
					<input
						type="password"
						class="form-control"
						id="password"
						name="password"
						placeholder="Minimum 12 characters"
						required
						minlength="12"
						autofocus
					/>
					@PasswordRequirements()
				</div>
				<div class="mb-4">
					<label for="confirm_password" class="form-label small text-muted">Confirm new password</label>
					<input
						type="password"
						class="form-control"
						id="confirm_password"
						name="confirm_password"
						placeholder="••••••••"
						required
					/>
				</div>
				<div id="auth-error" class="mb-3"></div>
				<button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 position-relative">
					<span id="reset-spinner" class="htmx-indicator spinner-border spinner-border-sm position-absolute top-50 start-50 translate-middle" role="status"></span>
					Update Password
				</button>
			</form>
		}
		<hr class="my-4"/>
		<p class="text-center text-muted small mb-0">
			<a href="/auth/login" style="color:var(--ctp-lavender);">Back to sign in</a>
		</p>
	}
}
