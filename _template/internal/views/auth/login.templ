package auth

templ LoginPage(showResetSuccess bool, csrfToken string) {
	@Layout("Sign In — goph", "Sign in to your account") {
		if showResetSuccess {
			<div class="alert alert-success py-2 small mb-3" role="alert">
				Password updated &mdash; you can now sign in.
			</div>
		}
		<form
			hx-post="/auth/login"
			hx-target="#auth-error"
			hx-swap="innerHTML"
			hx-indicator="#login-spinner"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div class="mb-3">
				<label for="email" class="form-label small text-muted">Email</label>
				<input
					type="email"
					class="form-control"
					id="email"
					name="email"
					placeholder="you@example.com"
					required
					autofocus
				/>
			</div>
			<div class="mb-4">
				<div class="d-flex justify-content-between align-items-baseline">
					<label for="password" class="form-label small text-muted">Password</label>
					<a href="/auth/forgot-password" class="small" style="color:var(--ctp-overlay1);">
						Forgot password?
					</a>
				</div>
				<input
					type="password"
					class="form-control"
					id="password"
					name="password"
					placeholder="••••••••"
					required
				/>
			</div>
			<div id="auth-error" class="mb-3"></div>
			<button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 position-relative">
				<span id="login-spinner" class="htmx-indicator spinner-border spinner-border-sm position-absolute top-50 start-50 translate-middle" role="status"></span>
				Sign In
			</button>
		</form>
		<hr class="my-4"/>
		<p class="text-center text-muted small mb-0">
			Don't have an account?
			<a href="/auth/register" style="color:var(--ctp-lavender);">Create one</a>
		</p>
	}
}
