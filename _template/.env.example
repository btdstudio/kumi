DATABASE_URL=postgres://postgres:postgres@localhost:5432/myapp?sslmode=disable
# Required. At least 32 characters. Generate one with: openssl rand -hex 32
SECRET_KEY=
# Public URL of the app, used to build links in emails and to decide whether
# cookies are marked Secure (https => Secure). Production must use https.
BASE_URL=http://localhost:8080
# Set to true ONLY when running behind a reverse proxy that overwrites
# X-Forwarded-For / X-Real-IP. Otherwise clients can spoof their IP.
TRUST_PROXY=false
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
